.env

# Artefatos de build (CLAUDE.md: nunca versionar)
**/target/
**/build/

# Editor local
.vscode/

# repowise codebase index (local, machine-specific)
.repowise/**

# Claude Code — estado local; agents/ e skills/ são versionados
.claude/settings.local.json
.claude/*.local.*

#============================
#      Gemini-Reviwer
#============================
# Node Scripts
.github/workflows/scripts/node_modules/
node_modules/

# Java / Spring Boot
target/
build/
.gradle/
.settings/
.classpath
.project
*.class


# Testes de carga: resultados podem ser versionados, mas nunca credenciais/tokens
# (os padroes valem na raiz de results/ e nas pastas de etapa: results/NN-etapa/)
Projeto/carga/results/**/users-*.json
Projeto/carga/results/**/events-*.json
# Matriz do experimento: o CSV (matriz.csv) e o registro; o HTML regenera e os resumos de repeticoes invalidas sao so diagnostico
Projeto/carga/results/**/matriz.html
Projeto/carga/results/**/matriz-invalida-*.json
# Escada de carga (#14): o CSV (degraus-<id>.csv) e o resumo (summary-degraus-<id>.json) sao versionados; o HTML regenera do CSV
Projeto/carga/results/**/degraus-*.html
**/tokens.json

# Supabase self-hosted: backup do sed -i.old do generate-keys.sh (o .env já é coberto pela regra acima)
.env.old

# Supabase self-hosted: dados do Postgres e snippets do Studio (volumes locais)
Projeto/supabase/volumes/db/data/
Projeto/supabase/volumes/snippets/

# Flutter (pub get no container de lint)
Projeto/frontend/.dart_tool/
Projeto/frontend/pubspec.lock
Projeto/frontend/.flutter-plugins*

# Saída local do cluster Kubernetes (CSV de réplicas do dry-run, etc.; issue #197)
Projeto/k8s/saida/

# Teste longo (soak, #232): o CSV bruto do k6 (~1 GB por bloco) fica no gerador; so o perfil e o soak-<id>-por-minuto.csv entram no repo (as amostras do cluster e do host sao diagnostico)
soak-*-k6.csv
soak-*-k6.csv.gz
Projeto/carga/results/**/soak-*-replicas.csv
Projeto/carga/results/**/soak-*-pods.csv

# bytecode do Python (kit de carga)
__pycache__/
