<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.demo</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>identity-client</artifactId>
    <name>identity-client</name>
    <description>Contrato HTTP do serviço identity (issue 36): DTOs User/MyWallet/LoginResult, UserApi e demais interfaces, exceções e o cliente que o gateway usa</description>

    <!-- Lib, não executável (sem spring-boot-maven-plugin), como a catalog-client. O serviço identity (fatia 2) depende dela
         pelo contrato e a usa nos testes ponta a ponta; o monólito (gateway) monta o IdentityClient (IdentityClientConfig, cutover da
         fatia 3). Nenhum dos dois enxerga o código do outro: a fronteira física é o HTTP. O serviço identity não escaneia o pacote
         identityclient (senão haveria um cliente de si mesmo no contexto). -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Balanceamento no cliente da trilha C (#197): DNS round-robin, TTL e reuso FIFO, desligado por padrão. -->
        <dependency>
            <groupId>com.example.demo</groupId>
            <artifactId>client-lb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Testes sem Spring do cliente (IdentityClientIndisponivelTest): JUnit 5 + servidores HTTP do JDK -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
