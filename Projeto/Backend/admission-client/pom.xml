<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.demo</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>admission-client</artifactId>
    <name>admission-client</name>
    <description>Contrato HTTP do serviço admission (issue 41): DTOs, AdmissionApi e o cliente (fail-open + disjuntor) que o gateway usa</description>

    <!-- Lib, não executável (sem spring-boot-maven-plugin), como a reservation-client. O serviço admission depende dela pelo contrato
         (os DTOs são o corpo da API interna) e a usa nos testes ponta a ponta; o monólito (gateway) monta o AdmissionClient
         (AdmissionClientConfig). Nenhum dos dois enxerga o código do outro: a fronteira física é o HTTP. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Cliente HTTP com pool de conexões dimensionável (o do JDK/RestTemplate default não tem pool configurável). -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Testes sem Spring do cliente (fail-open, disjuntor, timeouts): JUnit 5 + servidores HTTP do JDK -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
