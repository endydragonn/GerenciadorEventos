<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Quality gates do backend (issue #83). Método "medir antes de travar" (mesmo do toolkit
    vibe-coding-toolkit, adaptado de ESLint pra Checkstyle): regra sem violação existente nasce
    em error (trava o build); regra com violação existente também fica em error, mas os
    arquivos já violadores são listados como baseline documentada em
    checkstyle-suppressions.xml (não corrigidos aqui — ver issue #83). Nenhum arquivo novo pode
    entrar nessa lista sem justificativa: a regra já vale para código novo desde já.

    Rodar isolado: veja "Checkstyle" em Backend/CLAUDE.md (mvn checkstyle:check).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Baseline dos arquivos que já violavam alguma regra abaixo no dia em que a regra
         entrou (2026-09-04, issue #83): ver checkstyle-suppressions.xml, referenciado via
         <suppressionsLocation> no maven-checkstyle-plugin (pom.xml) — não declarado como
         módulo aqui porque ${config_loc} não é resolvido nesse cenário (arquivo local, não
         classpath) pelo maven-checkstyle-plugin 3.6.0. -->

    <!-- Teto de tamanho de arquivo. 350 foi escolhido medindo a distribuição real do projeto
         (find src/main -name '*.java' | xargs wc -l | sort -n, issue #83): de 36 arquivos em
         src/main/java, o maior antes deste teto era BffUserController.java (465 linhas) e
         UserRepository.java (351); o terceiro maior, EventRepository.java, tem 275. 350 fica
         acima do grosso dos arquivos (a maioria bem abaixo de 300) e isola exatamente os 2
         outliers como baseline — não é o "350" do toolkit JS copiado sem checar. -->
    <module name="FileLength">
        <property name="max" value="350"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">
        <!-- Banir saída direta de console em código de produção. O projeto já usa SLF4J em
             alguns pontos (ver reservation/ReservationExpiryService,
             reservation/ReadModelRefreshService) — é a referência do "caminho certo" citada na
             mensagem, já que não existe uma classe própria de log adapter. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="ProibirConsoleDireto"/>
            <property name="format" value="System\.(out|err)\.print(ln)?\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message"
                value="Não use System.out/err.print*/println em código de produção — logue com SLF4J (org.slf4j.Logger/LoggerFactory), como em reservation/ReservationExpiryService."/>
        </module>

        <!-- printStackTrace() joga o stack trace cru no console, mesmo problema do item
             acima. Zero ocorrências hoje (medido na issue #83) — nasce travando o build. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="ProibirPrintStackTrace"/>
            <property name="format" value="\.printStackTrace\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message"
                value="Não use printStackTrace() em código de produção — logue a exceção com SLF4J (org.slf4j.Logger/LoggerFactory), como em reservation/ReservationExpiryService."/>
        </module>
    </module>
</module>
