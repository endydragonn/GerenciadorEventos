# Segredos e configuração do Supabase self-hosted (db + Supavisor + Studio/meta/kong).
#
# Estes valores são do Supabase e SÃO SEPARADOS do Projeto/.env do backend: o backend
# também tem JWT_SECRET e POSTGRES_PASSWORD, mas com outro sentido. Não copie um no outro.
#
# As chaves usam os nomes de interpolação do compose upstream (${POSTGRES_PASSWORD} etc.).
# O serviço db do Projeto/docker-compose.yml lê este arquivo via `env_file` (#18); lá
# POSTGRES_HOST (socket) e POSTGRES_DB (meu_banco) são sobrepostos. O pooler (#19) e o Studio
# (#20) leem este arquivo pelo `env_file:` dos próprios serviços (docker-compose.pooler.yml e
# docker-compose.studio.yml, trazidos por `include`), porque a interpolação ${...} do compose
# principal lê o Projeto/.env e ele vence em nomes iguais (JWT_SECRET, POSTGRES_PASSWORD).
# Nenhum dos dois toca no Projeto/.env.
#
# SUPABASE_PUBLISHABLE_KEY e SUPABASE_SECRET_KEY precisam existir, mesmo vazias, no ambiente
# do Kong: sem elas o kong-entrypoint.sh deixa `$VAR` literal como credencial.
#
# Gere o .env (gitignored) a partir deste exemplo com utils/generate-keys.sh; ver README.md.
# Cada CHAVE= abaixo começa no início da linha de propósito: o generate-keys.sh --update-env
# substitui a linha inteira com sed (s|^CHAVE=.*$|...|).

############
# Segredos — preenchidos pelo generate-keys.sh
############

POSTGRES_PASSWORD=<gerado-por-generate-keys>
JWT_SECRET=<gerado-por-generate-keys>
ANON_KEY=<gerado-por-generate-keys>
SERVICE_ROLE_KEY=<gerado-por-generate-keys>
SECRET_KEY_BASE=<gerado-por-generate-keys>
VAULT_ENC_KEY=<gerado-por-generate-keys>
PG_META_CRYPTO_KEY=<gerado-por-generate-keys>

# Login do Studio (via kong). A senha também é gerada.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<gerado-por-generate-keys>

############
# Banco
############

POSTGRES_HOST=db
POSTGRES_DB=meu_banco
POSTGRES_PORT=5432
# Validade (s) dos JWTs emitidos
JWT_EXPIRY=3600

############
# Supavisor (pooler)
############

# Os valores NÃO secretos do pooler (POOLER_TENANT_ID, POOLER_POOL_MODE, POOLER_MAX_CLIENT_CONN,
# POOLER_DEFAULT_POOL_SIZE, DB_POOL_SIZE) moram, literais, no `environment:` de
# docker-compose.pooler.yml, que vence este arquivo: não os defina aqui. O dimensionamento e a
# justificativa estão em README.md. Os segredos do pooler (POSTGRES_PASSWORD, JWT_SECRET,
# SECRET_KEY_BASE, VAULT_ENC_KEY) vêm daqui pelo `env_file:` do serviço.

############
# Studio / kong
############

SUPABASE_PUBLIC_URL=http://localhost:8000
PGRST_DB_SCHEMAS=public
STUDIO_DEFAULT_ORGANIZATION=Gerenciador de Eventos
STUDIO_DEFAULT_PROJECT=Gerenciador de Eventos
# Chaves opacas (sb_...): não usadas aqui; devem ficar VAZIAS, mas presentes (ver cabeçalho)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
